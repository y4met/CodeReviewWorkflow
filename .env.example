# ===== LLM 配置（OpenAI 兼容接口）=====
# 复制本文件为 .env 并填入真实值
# OpenAI:
#   OPENAI_API_KEY=sk-xxxx
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   MODEL_NAME=gpt-4o-mini
# DeepSeek:
#   OPENAI_API_KEY=sk-xxxx
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   MODEL_NAME=deepseek-chat
# Kimi / Moonshot:
#   OPENAI_API_KEY=sk-xxxx
#   OPENAI_BASE_URL=https://api.moonshot.cn/v1
#   MODEL_NAME=moonshot-v1-8k
# 通义千问 DashScope(兼容模式):
#   OPENAI_API_KEY=sk-xxxx
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   MODEL_NAME=qwen-plus

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ===== Workflow 行为配置 =====
# 审查最大轮次（coder 之后 review<->fixer 的循环上限）
MAX_ROUNDS=3
# 单个节点失败时的重试次数
NODE_RETRIES=2
# LLM 调用失败重试次数
MAX_RETRIES=3
# 代码执行超时（秒）
CODE_TIMEOUT=10
# 是否启用并行审查（静态LLM审查 || 动态运行测试）
ENABLE_PARALLEL=true
# 工作目录（代码执行/文件读写根目录）
WORKSPACE=./sandbox
# 检查点目录（每次运行的状态快照，用于恢复）
RUNS_DIR=./runs
# Web 可视化服务端口
WEB_PORT=5000
